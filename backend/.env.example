
# ==========================================
# SERVER
# ==========================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173


# ==========================================
# DATABASE
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/college_portal


# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
JWT_EXPIRE=24h


# ==========================================
# EMAIL CONFIGURATION (GMAIL SMTP)
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=yourmail@gmail.com
MAIL_PASS=YOUR_NEW_GMAIL_APP_PASSWORD
MAIL_FROM=College Portal <noreply@college.edu>


# ==========================================
# FILE UPLOAD
# ==========================================
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760


# ==========================================
# OTP CONFIGURATION
# ==========================================
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60


# ==========================================
# ADMIN CONFIGURATION
# ==========================================
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD


# ==========================================
# AI CONFIGURATION - PROVIDER FALLBACK
# ==========================================

# AI Provider Priority
# 1. Gemini (all configured keys)
# 2. Groq (all configured keys)

AI_TIMEOUT=30000
AI_MAX_RETRIES=2


# ==========================================
# GROQ API - FALLBACK PROVIDER
# ==========================================

# Multiple Groq keys separated by commas
GROQ_API_KEYS=YOUR_GROQ_KEY_1,YOUR_GROQ_KEY_2

# Groq API endpoint
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

# Groq model
GROQ_MODEL=llama-3.3-70b-versatile

# Legacy compatibility (if your controller still uses singular variable)
GROQ_API_KEY=YOUR_GROQ_KEY_1
LLM_MODEL=llama-3.3-70b-versatile


# ==========================================
# GOOGLE GEMINI API - PRIMARY PROVIDER
# ==========================================

# Multiple Gemini API keys separated by commas
GEMINI_API_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2

# Gemini model
GEMINI_MODEL=gemini-3.8-flash


# ==========================================
# GOOGLE CLOUD (OPTIONAL)
# ==========================================
GOOGLE_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY
