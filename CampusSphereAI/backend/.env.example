
# SERVER
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# DATABASE
MONGODB_URI=mongodb://127.0.0.1:27017/college_portal

# JWT
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
JWT_EXPIRE=24h

# EMAIL
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=yourmail@gmail.com
MAIL_PASS=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=College Portal <noreply@college.edu>

# FILE UPLOAD
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# ADMIN
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

# AI - GROQ PRIMARY
GROQ_API_KEY=YOUR_GROQ_API_KEY
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile

# AI - GOOGLE GEMINI (OPTIONAL FALLBACK)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=YOUR_SUPPORTED_GEMINI_MODEL

# GOOGLE CLOUD (OPTIONAL)
GOOGLE_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY
